MDOP_MYSQL_IMAGE=mysql:8.4.10
MDOP_MYSQL_CONTAINER_NAME=mdop-mysql
MDOP_MYSQL_PORT=3306
MDOP_MYSQL_DATABASE=mdop
MDOP_MYSQL_USER=mdop_app
MDOP_MYSQL_PASSWORD=replace_with_local_password
MDOP_MYSQL_ROOT_PASSWORD=replace_with_local_root_password

MDOP_RABBITMQ_IMAGE=rabbitmq:4.3.2-management
MDOP_RABBITMQ_CONTAINER_NAME=mdop-rabbitmq
MDOP_RABBITMQ_HOSTNAME=mdop-rabbitmq
MDOP_RABBITMQ_AMQP_PORT=5672
MDOP_RABBITMQ_MANAGEMENT_PORT=15672
MDOP_RABBITMQ_USER=mdop_app
MDOP_RABBITMQ_PASSWORD=replace_with_local_password
MDOP_RABBITMQ_VHOST=mdop

MDOP_REDIS_IMAGE=redis:8.2.7
MDOP_REDIS_CONTAINER_NAME=mdop-redis
MDOP_REDIS_PORT=6379
MDOP_REDIS_PASSWORD=replace_with_local_password

MDOP_TIME_ZONE=Asia/Shanghai

# Project-local toolchain and HTTP port (no global environment changes).
# Fill the installed paths on this machine.
MDOP_JAVA_HOME=
MDOP_NODE_HOME=

# 可选分角色操作账号（仅示例；按实际仓库ID填写，不授予 ADMIN）。
# MDOP_AUTH_OPERATORS_0_USERNAME=receiver
# MDOP_AUTH_OPERATORS_0_PASSWORD=replace_with_unique_local_password
# MDOP_AUTH_OPERATORS_0_AUTHORITIES=wms:arrival:read,wms:receipt:create,wms:receipt:submit,wms:correction:read,wms:correction:create,wms:warehouse:1
# MDOP_AUTH_OPERATORS_1_USERNAME=reviewer
# MDOP_AUTH_OPERATORS_1_PASSWORD=replace_with_another_unique_password
# MDOP_AUTH_OPERATORS_1_AUTHORITIES=wms:arrival:read,wms:correction:read,wms:correction:approve,wms:warehouse:1
MDOP_BACKEND_PORT=8081
MDOP_ADMIN_USERNAME=admin
MDOP_ADMIN_PASSWORD=replace_with_at_least_12_random_characters
